# Copia este archivo a .env y ajusta los valores en local.
# Aquí no van contraseñas, tokens ni claves.
#
# Antes de `mlflow run`, carga el archivo para que el run padre use el
# mismo almacén y el mismo experimento que src/futbol/mlops/:
#   set -a && source .env && set +a
#   mlflow run . --env-manager local

# Metadatos de MLflow en local. Al usarlo se genera mlflow.db (artefactos en mlruns/).
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Nombres que concentra src/futbol/mlops/config.py.
MLFLOW_EXPERIMENT_NAME=futbol-1x2
MLFLOW_MODEL_NAME=futbol-1x2

# Alias del candidato. register.py lo asigna; predict.py y el servicio cargan ese alias.
MLFLOW_MODEL_ALIAS=challenger

# Semilla de los modelos.
RANDOM_SEED=42

# Dataset de partidos con features (lo genera `futbol build`).
DATA_PATH=data/processed/matches.parquet

# Temporada desde la que empieza la prueba (formato football-data: 2526 = 2025-26).
TEST_FROM_SEASON=2526

# Token de football-data.org (opcional, solo para `futbol download`).
# FOOTBALL_DATA_ORG_TOKEN=
